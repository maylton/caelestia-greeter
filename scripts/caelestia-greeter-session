#!/usr/bin/env bash
set -euo pipefail

load_env() {
    [[ -r "$1" ]] || return 0
    set -a
    source "$1"
    set +a
}

load_env /etc/locale.conf
load_env "${CAELESTIA_GREETER_PROFILE_ENV:-/run/caelestia-greeter/profile.env}"

config_dir="${CAELESTIA_GREETER_CONFIG_DIR:-/etc/xdg/quickshell/caelestia-greeter}"
exec /usr/bin/qs -p "$config_dir"
