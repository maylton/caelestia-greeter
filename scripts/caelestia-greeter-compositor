#!/usr/bin/env bash
set -euo pipefail

service_user="${CAELESTIA_GREETER_SERVICE_USER:-$(id -un)}"
passwd_entry="$(getent passwd "$service_user" || true)"

if [[ -n "$passwd_entry" ]]; then
    IFS=: read -r _ _ service_uid _ _ service_home _ <<<"$passwd_entry"
else
    service_uid="$(id -u)"
    service_home="/var/lib/greetd"
fi

service_home="${service_home:-/var/lib/greetd}"
cache_dir="${CAELESTIA_GREETER_COMPOSITOR_CACHE_DIR:-/var/cache/caelestia-greeter/runtime-$service_user}"

if [[ -z "${HOME:-}" || "$HOME" == "/" ]]; then
    export HOME="$service_home"
fi

if [[ -z "${XDG_CACHE_HOME:-}" || ! -d "$XDG_CACHE_HOME" || ! -w "$XDG_CACHE_HOME" ]]; then
    export XDG_CACHE_HOME="$cache_dir"
fi

if ! mkdir -p "$XDG_CACHE_HOME" 2>/dev/null || [[ ! -w "$XDG_CACHE_HOME" ]]; then
    export XDG_CACHE_HOME="/tmp/caelestia-greeter-cache-$service_uid"
    mkdir -p "$XDG_CACHE_HOME"
    chmod 0700 "$XDG_CACHE_HOME"
fi

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland

hyprland_config="${CAELESTIA_GREETER_HYPRLAND_CONFIG:-$XDG_CACHE_HOME/caelestia-greeter-hyprland.lua}"
config_tmp="${hyprland_config}.tmp.$$"

cat > "$config_tmp" <<'LUA'
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = 1,
})

hl.config({
    input = {
        kb_layout = "br",
    },
    misc = {
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        force_default_wallpaper = 0,
    },
    animations = {
        enabled = false,
    },
    decoration = {
        rounding = 0,
        blur = {
            enabled = false,
        },
        shadow = {
            enabled = false,
        },
    },
})

hl.on("hyprland.start", function()
    hl.exec_cmd("/usr/local/bin/caelestia-greeter-run")
end)
LUA

chmod 0600 "$config_tmp"
mv -f "$config_tmp" "$hyprland_config"

if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland -- -c "$hyprland_config"
fi

exec /usr/bin/Hyprland --config "$hyprland_config"
