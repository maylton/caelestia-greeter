#!/usr/bin/env bash
set -euo pipefail

marker="${XDG_RUNTIME_DIR:-/tmp}/caelestia-greeter-launch-requested"
rm -f "$marker"

status=0
/usr/local/bin/caelestia-greeter-session || status=$?

if [[ -f "$marker" ]]; then
    /usr/bin/hyprctl dispatch exit >/dev/null 2>&1 || true
    exit 0
fi

printf 'Caelestia Greeter exited unexpectedly with status %s.\n' "$status" >&2
exec /usr/bin/sleep infinity
