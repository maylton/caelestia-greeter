// Minimal Niri session used only to host Lumina Greeter.
// The greeter writes a runtime marker only after greetd accepts the target
// desktop session. Unexpected Quickshell exits must not tear down this Niri.
spawn-at-startup "/usr/bin/sh" "-c" "marker=\"${XDG_RUNTIME_DIR:-/tmp}/lumina-greeter-launch-requested\"; rm -f \"$marker\"; /usr/bin/lumina-greeter-session; status=$?; if [ -f \"$marker\" ]; then /usr/bin/niri msg action quit --skip-confirmation; exit 0; fi; echo \"Lumina Greeter exited unexpectedly with status $status; keeping temporary Niri active.\" >&2; exec /usr/bin/sleep infinity"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

input {
    keyboard {
        xkb {
            layout "br"
        }
    }
}

layout {
    gaps 0
    background-color "#101018"
}
